{
  "name": "applydesk-local",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Browser-based interface tests for ApplyDesk",
  "scripts": {
    "test": "node --experimental-vm-modules --test --test-concurrency=1 tests/*.test.mjs tests/*.test.cjs tests/*.test.js",
